{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mechsim-gemini-proxy",
    "main": "src/index.js",
    "compatibility_date": "2026-10-26",
    "workers_dev": true,
    "vars": {
        "ALLOWED_ORIGINS": "https://imtuu.me,https://imtua.github.io,http://localhost:8000,http://127.0.0.1:8000",
        "GEMINI_PROJECT_ID": "gen-lang-client-0293438954",
        "GEMINI_MODEL": "gemini-2.5-flash"
    },
    "ratelimits": [
        {
            "name": "CHAT_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 5,
                "period": 60
            }
        }
    ]
}
