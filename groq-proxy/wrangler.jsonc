{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mechsim-groq-proxy",
    "main": "src/index.js",
    "compatibility_date": "2026-10-26",
    "workers_dev": true,
    "vars": {
        "ALLOWED_ORIGINS": "https://imtua.github.io,http://localhost:8000,http://127.0.0.1:8000",
        "GROQ_MODEL": "openai/gpt-oss-20b"
    },
    "secrets": {
        "required": ["GROQ_API_KEY"]
    },
    "ratelimits": [
        {
            "name": "CHAT_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 5,
                "period": 60
            }
        }
    ]
}
